# Copie para .env e ajuste. Sem .env, o site sobe em HTTP na porta 80.

# Domínio público do site. Com ele preenchido, o HTTPS é ligado automaticamente.
# O domínio precisa apontar para o servidor e as portas 80 e 443 precisam estar abertas.
#SITE_ADDRESS=painel.exemplo.com.br

# Portas do servidor (mude só para testar em uma máquina que já usa a 80 ou a 443).
#HTTP_PORT=80
#HTTPS_PORT=443
